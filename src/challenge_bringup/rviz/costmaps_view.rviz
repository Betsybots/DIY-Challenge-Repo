Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Color: 160; 160; 160
      Cell Size: 1.0
      Cell Count: 20
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Static Map
      Enabled: true
      Topic: /map
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic: /global_costmap/costmap
      Alpha: 0.6
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic: /local_costmap/costmap
      Alpha: 0.7
      Color Scheme: costmap
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 50

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Color: 160; 160; 160
      Cell Size: 1.0
      Cell Count: 20
      Alpha: 0.5
    - Class: rviz_default_plugins/Odometry
      Name: Wheel Odometry
      Enabled: true
      Topic: /wheel_cmd_vel
      Keep: 200
      Color: 0; 200; 0
      Angle Tolerance: 0.1
      Position Tolerance: 0.1
    - Class: rviz_default_plugins/Path
      Name: Wheel Odom Path
      Enabled: true
      Topic: /wheel_cmd_vel
      Color: 0; 200; 0
      Line Width: 0.02
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 50

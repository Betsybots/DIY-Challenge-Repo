  </link>

  <joint name="chassis_wheel_1_revolute" type="continuous">
    <parent link="chassis"/>
    <child link="wheel_1"/>
    <origin xyz="0.554283 0.625029 -0.025" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="wheel_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.145833" ixy="0.0" ixz="0.0" iyy="0.145833" iyz="0.0" izz="0.125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.25"/>
      </geometry>
      <material name="red"/>

<?xml version="1.0"?>
<!--
  DIY Challenge 2026 — Robot Description
  ========================================
  Frame conventions follow REP-103 and REP-105.
  All extrinsics below are PLACEHOLDER values.
  Replace every "CALIB:" comment with measured/calibrated values
  before running autonomous navigation.

  Frame tree (required by Nav2 & FAST-LIO2):
    map
     └── odom            (published by navsat_transform / EKF2)
          └── base_footprint  (published by EKF2 via /odometry/filtered)
               └──base_link  (published by URDF via robot_state_publisher)
                    ├── lidar_link   <- fixed, from lidar_imu_calib
                    ├── imu_link     <- fixed, from lidar_imu_calib
                    ├── camera_link  <- fixed, from cam_lidar_calib
                    └── gps_link     <- fixed, measured lever arm

  Robot body: 406 mm L × 406 mm W × 406 mm H (16" × 16" × 16")
  All dimensions in metres, angles in radians.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="juggernaut">
  <!-- Define robot constants -->

  <xacro:property name="base_off_ground" value="0.0714375"/> <!-- 2.8125 inches-->
  <xacro:property name="base_width" value="0.27305"/> <!-- 10.75 inches (chassis only; total width incl. wheels = 16 in / 0.4064 m)-->
  <xacro:property name="base_length" value="0.498475"/> <!-- 19.625 + 7.5 (pool noodle radius) inches-->
  <xacro:property name="base_height" value="0.18415"/> <!-- 7.25 inches-->
  <xacro:property name="pool_noodle_radius" value="0.047625"/> <!-- 1.875 inches-->

  <xacro:property name="wheel_radius" value="0.09445625"/> <!-- 3.71875 inches-->
  <xacro:property name="wheel_width" value="0.0508"/><!-- 2 inches-->
  <xacro:property name="wheel_ygap" value="0.041275"/><!-- 1.625 inches--> 
  <xacro:property name="wheel_zoff" value="0.06985"/> <!-- 2.75 inches--> 
  <xacro:property name="drive_wheel_xoff" value="0.1254125"/><!-- 4.9375 inches-->
  <xacro:property name="rear_wheel_xoff" value="0.1476375"/><!-- 5.8125 inches-->
  <xacro:property name="castor_wheel_radius" value="0.01"/> <!-- 3.71875 inches-->

  <xacro:property name="camera_screw_zoff" value="-0.0385"/>
  <xacro:property name="camera_screw_xoff" value="-0.007"/>
  <!-- New Values-->
  <xacro:property name="body_mass" value="10.0"/> <!-- in Kg-->
  <xacro:property name="base_off_ground" value="0.0523875"/> <!-- 2.0625 inches-->
  <xacro:property name="base_width" value="0.2159"/> <!-- 8.5 inches (chassis only; total width incl. wheels = 16 in / 0.4064 m)-->
  <xacro:property name="base_length" value="0.419735"/> <!-- 16.525 inches-->
  <xacro:property name="base_height" value="0.1524"/> <!-- 6 inches-->
  <xacro:property name="pool_noodle_radius" value="0.047625"/> <!-- 1.875 inches-->

  <xacro:property name="wheel_radius" value="0.0762"/> <!-- 3 inches-->
  <xacro:property name="wheel_width" value="0.0254"/><!-- 1 inches-->
  <xacro:property name="wheel_ygap" value="0.016256"/><!-- 0.64 inches--> 
  <xacro:property name="wheel_zoff" value="0.0"/> <!-- 0 inches--> 
  <xacro:property name="drive_wheel_xoff" value="0.0"/><!-- 0 inches-->
  <xacro:property name="rear_wheel_xoff" value="0.2794"/><!-- 11 inches-->
  <xacro:property name="castor_wheel_radius" value="0.01"/> <!-- 3.71875 inches-->
  <xacro:property name="sensor_xoff_from_AR" value="0.072644"/> <!-- 2.86 inches-->
  <xacro:property name="Lidar_base_height_from_AR" value="0.1285875"/> <!-- 5.0625 inches-->
  <xacro:property name="imu_height_from_AR" value="0.0333375"/> <!-- 1.3125 inches-->
  <xacro:property name="AR_from_front" value="0.0964565"/> <!-- 3.7975 inches-->
  
  <xacro:property name="camera_screw_zoff" value="-0.0385"/>
  <xacro:property name="camera_screw_xoff" value="-0.007"/>


  <!-- <xacro:property name="lidar_radius" value="0.038125"/>
  <xacro:property name="lidar_length" value="0.076"/> --> <!-- old values defined as per the actual measurements -->
  <xacro:property name="lidar_radius" value="0.0516"/>
  <xacro:property name="lidar_length" value="0.0717"/>
  <xacro:property name="imu_length" value="0.03"/>
  <xacro:property name="imu_width" value="0.03"/>
  <xacro:property name="imu_height" value="0.02"/>
  <xacro:property name="hesai_centroid_y" value="-0.0298"/>
  <xacro:property name="hesai_centroid_z" value="0.0124"/>
  
  <xacro:arg name="use_nominal_extrinsics" default="true" />
  <xacro:include filename="lidar.urdf.xacro" />
  <xacro:include filename="imu.urdf.xacro" />

  <xacro:lidar_3d_v1 parent="base_link" lidar_radius="${lidar_radius}" lidar_length="${lidar_length}">
    <origin xyz="${sensor_xoff_from_AR} 0 ${Lidar_base_height_from_AR}" rpy="0 0 0" />
   <!-- <origin xyz="0.569632 -0.03223 0.502056" rpy="0 0 0" /> -->
  </xacro:lidar_3d_v1>

  <xacro:imu_v1 parent="base_link" imu_length="${imu_length}" imu_width="${imu_width}" imu_height="${imu_height}">
    <origin xyz="${sensor_xoff_from_AR} 0 ${imu_height_from_AR}" rpy="0 0 0" />
  </xacro:imu_v1>

  <material name="transparent_blue">
    <color rgba="0.0 0.0 1.0 0.75"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 1.0 0.0 1.0"/>
  </material>
  <material name="Gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Wheel xacro -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect wheel_xoff joint_type">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="red"/>
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.6"/>
        <!-- solid cylinder around local Y (since we rotated the cylinder) -->
        <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0010" iyz="0" izz="0.0012"/>
      </inertial>    <!-- ADD: collision matches visual -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <!-- optional: stiffer contact so they don't sink -->
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <gazebo reference="${prefix}_link">
        <material>Gazebo/Red</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1e6</kp>
        <kd>1.0</kd>
    </gazebo>
    
    <joint name="${prefix}_joint" type="${joint_type}">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${-wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20.0" velocity="10.0"/>
    </joint>
  </xacro:macro>
  
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${AR_from_front-base_length/2} 0 ${base_height/2+base_off_ground-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <inertial>
      <origin xyz="${AR_from_front-base_length/2} 0 ${base_height/2+base_off_ground-wheel_radius}" rpy="0 0 0"/> <!-- change based on TF -->
      <mass value="${body_mass}"/>
      <inertia ixx="0.5 * body_mass * (base_width * base_width + base_height * base_height)" ixy="0.0" ixz="0.0" 
               iyy="0.5 * body_mass * (base_length * base_length + base_height * base_height)" iyz="0.0" 
               izz="0.5 * body_mass * (base_length * base_length + base_width * base_width)"/>
    </inertial>
    <visual>
      <origin xyz="${AR_from_front-base_length/2} 0 ${base_height/2+base_off_ground-wheel_radius}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${AR_from_front-base_length/2} 0 ${base_height/2+base_off_ground-wheel_radius}" rpy="0 0 0"/> <!-- change based on TF -->
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>
  
  <link name="caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <joint name="chassis_caster_ball" type="continuous">
    <parent link="chassis"/>
    <child link="caster"/>
    <origin xyz="${-1*rear_wheel_xoff} 0.0 ${-1*wheel_zoff}" rpy="0 0 0"/>
  </joint>
  
  <xacro:wheel prefix="drivewhl_l" x_reflect="1" y_reflect="1" wheel_xoff="${drive_wheel_xoff}" joint_type="continuous"/>
  <xacro:wheel prefix="drivewhl_r" x_reflect="1" y_reflect="-1" wheel_xoff="${drive_wheel_xoff}" joint_type="continuous"/>
  <!--<xacro:wheel prefix="rearwhl_l" x_reflect="-1" y_reflect="1" wheel_xoff="${rear_wheel_xoff}" joint_type="continuous"/>
  <xacro:wheel prefix="rearwhl_r" x_reflect="-1" y_reflect="-1" wheel_xoff="${rear_wheel_xoff}" joint_type="continuous"/>
  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>drivewhl_l_joint</left_joint>
        <right_joint>drivewhl_r_joint</right_joint>
        <wheel_separation>${base_width+2*wheel_ygap}</wheel_separation> <!-- Adjust to your robot's width (meters) -->
        <wheel_radius>${wheel_radius}</wheel_radius>     <!-- Adjust to your wheel radius (meters) -->
        <topic>cmd_vel</topic>
        <odom_topic>odom_wheel</odom_topic>   <!-- wheel encoder odom — drifts on ramp/slip -->
        <!-- Publish odom→base_footprint TF — must match Nav2 robot_base_frame.
             Ignition namespaces these as diy_robot/odom→diy_robot/base_footprint.
             SIM only: on real robot EKF1/EKF2 publish this transform instead. -->
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <tf_topic>/tf</tf_topic>
        <robot_param_node>/robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
  <!-- SIM ONLY: Ground-truth odometry from Gazebo physics engine.
       Publishes perfect pose to /odom — no wheel slip drift.
       On real robot: EKF2 fuses wheel + IMU + NDT into /odometry/filtered instead. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic> <joint_name>drivewhl_l_joint</joint_name>
        <joint_name>drivewhl_r_joint</joint_name>
    </plugin>
  </gazebo>
   <!-- INSERT GROUND TRUTH POSE PUBLISHER HERE -->
  <gazebo>
    <plugin filename="libignition-gazebo-pose-publisher-system.so"
          name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <publish_model_pose>true</publish_model_pose>
    </plugin>
  </gazebo>


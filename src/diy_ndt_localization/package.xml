<?xml version="1.0"?>
<package format="3">
  <name>diy_ndt_localization</name>
  <version>0.1.0</version>
  <description>
    NDT-OMP based map-matching localization for the DIY Robot Challenge 2026.
    Loads GlobalMap.pcd produced by LIO-SAM, matches each incoming Hesai lidar
    scan, and publishes the map->odom transform consumed by Nav2.
  </description>

  <maintainer email="team@juggernauts.local">Team Juggernauts</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>ndt_omp_ros2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

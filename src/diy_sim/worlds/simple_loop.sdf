<?xml version="1.0" ?>
<sdf version='1.9'>
  <!--
    Simple Loop Arena — nav pipeline loop validation (no obstacles).
    Same track geometry as competition_arena.sdf but with:
      - NO narrow section (Leg 2 is full 1.05 m wide end-to-end)
      - NO ramp, gravel patch
      - NO bumps, buckets
      - NO wide section (Leg 3 uniform 1.05 m wide)
      - NO tunnel
    Use this to confirm the circuit_runner completes clean laps before
    re-introducing obstacles one by one.

    Track layout (metres):
      Leg 1: +X, y_center=0,    x=0..13
      Turn1: right at x=13
      Leg 2: -Y, x_center=13,   y=0..-13   (full 1.05 m, no narrow)
      Turn2: right at y=-13
      Leg 3: -X, y_center=-13,  x=13..0    (uniform 1.05 m)
      Turn3: left  at x=0
      Leg 4: +Y, x_center=-0.5, y=-13..0
      Gate:  x=-1..0, y=0
  -->
  <world name='simple_loop'>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <plugin name='gz::sim::systems::Physics'          filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands'     filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact'          filename='ignition-gazebo-contact-system'/>
    <plugin filename="ignition-gazebo-imu-system"     name="ignition::gazebo::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"          name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grass texture overlay -->
    <include>
      <name>ground_plane_image</name>
      <uri>model://grass_plane</uri>
    </include>

    <!-- ================================================================
         LEG 1  (+X, y_center=0, x=0..13.525)
         ================================================================ -->

    <!-- Start posts (yellow) -->
    <model name='start_post_n'>
      <static>true</static>
      <pose>0.0 0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.08 0.08 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.08 0.08 0.6</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='start_post_s'>
      <static>true</static>
      <pose>0.0 -0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.08 0.08 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.08 0.08 0.6</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Leg 1 north wall  y=+0.525, x=0..13.525 -->
    <model name='l1_n_wall'>
      <static>true</static>
      <pose>6.7625 0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>13.525 0.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>13.525 0.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Leg 1 south wall  y=-0.525, x=0..12.475 -->
    <model name='l1_s_wall'>
      <static>true</static>
      <pose>6.2375 -0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>12.475 0.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>12.475 0.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         LEG 2  (-Y, x_center=13, y=0..-13) — full width, no narrow
         East (outer) wall x=13.525
         West (inner) wall x=12.475
         ================================================================ -->

    <!-- Leg 2 east (outer) wall  x=13.525, y=+0.525..-13.525 -->
    <model name='l2_e_wall'>
      <static>true</static>
      <pose>13.525 -6.5 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.05 14.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.05 14.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Leg 2 west (inner) wall  x=12.475, y=-0.525..-12.475 (full, no narrow) -->
    <model name='l2_w_wall'>
      <static>true</static>
      <pose>12.475 -6.5 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.05 11.95 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.05 11.95 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         LEG 3  (-X, y_center=-13, x=13..0) — uniform 1.05 m width
         South wall y=-13.525,  North wall y=-12.475
         ================================================================ -->

    <!-- Leg 3 south (outer) wall  y=-13.525, x=0..13.525 -->
    <model name='l3_s_wall'>
      <static>true</static>
      <pose>6.7625 -13.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>13.525 0.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>13.525 0.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Leg 3 north (inner) wall  y=-12.475, x=0..12.475 -->
    <model name='l3_n_wall'>
      <static>true</static>
      <pose>6.2375 -12.475 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>12.475 0.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>12.475 0.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         LEG 4  (+Y, x_center=-0.5, y=-12.475..-0.525)
         East wall x=0,  West wall x=-1.0
         ================================================================ -->

    <!-- Leg 4 east wall  x=0, y=-0.525..-12.475 -->
    <model name='leg4_e_wall'>
      <static>true</static>
      <pose>0.0 -6.5 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.05 11.95 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.05 11.95 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Leg 4 west wall  x=-1.0, y=-0.525..-12.475 -->
    <model name='leg4_w_wall'>
      <static>true</static>
      <pose>-1.0 -6.5 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.05 11.95 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.05 11.95 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SW corner cap  y=-13.525, x=-1..0 -->
    <model name='turn3_sw_cap'>
      <static>true</static>
      <pose>-0.5 -13.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>1.0 0.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>1.0 0.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NW corner cap  y=+0.525, x=-1..0 -->
    <model name='turn4_nw_cap'>
      <static>true</static>
      <pose>-0.5 0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>1.0 0.05 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>1.0 0.05 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         START / FINISH GATE
         ================================================================ -->

    <!-- Finish posts (yellow)  x=-1.0 -->
    <model name='finish_post_n'>
      <static>true</static>
      <pose>-1.0 0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.08 0.08 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.08 0.08 0.6</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='finish_post_s'>
      <static>true</static>
      <pose>-1.0 -0.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.08 0.08 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.08 0.08 0.6</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SW turn marker posts (orange)  x=0, y=-12.475 / -13.525 -->
    <model name='sw_turn_post_n'>
      <static>true</static>
      <pose>0.0 -12.475 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.08 0.08 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.08 0.08 0.6</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='sw_turn_post_s'>
      <static>true</static>
      <pose>0.0 -13.525 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.08 0.08 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.08 0.08 0.6</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
